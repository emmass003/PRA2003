# PRA2003 - Week 3 deliverable
# Biology track: E. coli / Bacillus / Pseudomonas / Streptococcus /
#                 Mycobacterium / Salmonella strains, file "output-Set1.txt"
#
# The file has one line per particle/bacterium reading, grouped into events:
#   HEADER line: "eventNumber nParticles"        (2 fields)
#   DATA line:   "px py pz bacterialID"           (4 fields, ID is the last one)
#
# For each of the 12 bacterial strains we want:
#   average count per event = (total times that strain appears) / (number of events)
#   uncertainty             = sqrt(total count) / (number of events)   [Poisson stats]
#
# Some events have 0 particles at all (header line like "77 0") - these are
# excluded from the "number of events" used in the average, since nothing
# was observed in them.
#
# The file is ~810MB / ~25 million lines, too big to safely load into memory
# all at once on this machine (8GB RAM) -> read it in chunks instead.

filepath <- "output-Set1.txt"

# Defensive check: fail early with a clear message instead of a cryptic
# error if the data file isn't where this script expects it to be.
# (In RStudio: Session > Set Working Directory > To Source File Location.
#  In VS Code: make sure the R terminal's working directory is the folder
#  containing this script and output-Set1.txt, or edit filepath above to
#  the full path of the file on your machine.)
if (!file.exists(filepath)) {
  stop("Cannot find '", filepath, "' in the current working directory (",
       getwd(), "). Set your working directory to the folder containing ",
       "the data file, or replace filepath with the full path to the file.")
}

# The 12 bacterial strains of interest and their ID codes
strainID <- c(211, -211, 321, -321, 2212, -2212,
              3122, -3122, 3312, -3312, 3334, -3334)
strainName <- c("E. coli WT", "E. coli mutant",
                 "Bacillus subtilis WT", "Bacillus subtilis mutant",
                 "Pseudomonas aeruginosa WT", "Pseudomonas aeruginosa antibiotic-resistant",
                 "Streptococcus pneumoniae", "Capsule-deficient S. pneumoniae",
                 "Mycobacterium tuberculosis", "Drug-resistant M. tuberculosis",
                 "Salmonella enterica", "Salmonella mutant")
nStrains <- length(strainID)

# Running totals, updated chunk by chunk
totalCount <- rep(0, nStrains)
nEvents <- 0
chunkSize <- 1000000  # number of lines read at a time

con <- file(filepath, "r")

repeat {
  chunk <- readLines(con, n = chunkSize)
  if (length(chunk) == 0) {
    break  # reached end of file
  }

  # Count whitespace-separated fields on each line to tell header vs data lines apart
  nFields <- lengths(gregexpr("\\S+", chunk))

  isHeader <- (nFields == 2)
  isData   <- (nFields == 4)

  # Some events have 0 particles (e.g. "77 0") - these are excluded from
  # the event count used for the average, since there was nothing to observe
  headerLines <- chunk[isHeader]
  if (length(headerLines) > 0) {
    nParticlesInEvent <- as.integer(sub("^\\S+\\s+", "", headerLines))
    nEvents <- nEvents + sum(nParticlesInEvent > 0)
  }

  dataLines <- chunk[isData]
  if (length(dataLines) > 0) {
    # bacterial ID is always the last whitespace-separated field
    ids <- as.integer(sub("^.*\\s", "", dataLines))

    for (i in 1:nStrains) {
      totalCount[i] <- totalCount[i] + sum(ids == strainID[i])
    }
  }
}

close(con)

if (nEvents == 0) {
  stop("No events found in file - check the file path/format.")
}

avgPerEvent <- totalCount / nEvents
uncertainty <- sqrt(totalCount) / nEvents

results <- data.frame(
  ID = strainID,
  Strain = strainName,
  TotalCount = totalCount,
  AveragePerEvent = round(avgPerEvent, 5),
  Uncertainty = round(uncertainty, 5)
)

cat("Total events processed:", nEvents, "\n\n")
print(results)

