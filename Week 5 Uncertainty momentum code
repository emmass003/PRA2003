# PRA2003 - Question 3: straight-line fit of the WT - mutant difference vs momentum
#
# Run AFTER momentum_asymmetry.R. It only reads momentum_counts_per_set.csv,
# so it finishes in a second.
#
# WHAT IT DOES:
#   1. For every strain and momentum bin it takes the difference
#        D = N_WT - N_mutant
#      in each of the 10 sets, and computes
#        average     = average of the 10 values
#        uncertainty = standard deviation of the 10 values (sigma)
#   2. For every strain it fits a straight line through the 5 bins:
#        D = intercept + slope * bin      (bin = 1, 2, 3, 4, 5)
#      with a weighted least-squares fit (weight = 1 / sigma^2), so bins with
#      a small uncertainty count more. This gives the slope and the
#      y-intercept, each with its own uncertainty:
#        S   = sum(w),  Sx = sum(w x),  Sxx = sum(w x^2)
#        Sy  = sum(w y), Sxy = sum(w x y),  Delta = S*Sxx - Sx^2
#        slope     = (S*Sxy - Sx*Sy) / Delta     +- sqrt(S   / Delta)
#        intercept = (Sxx*Sy - Sx*Sxy) / Delta   +- sqrt(Sxx / Delta)
#   3. slope / uncertainty = significance of the slope.
#      If |slope| >= 3 sigma, D really changes with momentum.
#      chi2 / ndf tells whether a straight line describes the points well
#      (around 1 = good fit).
#
# OUTPUT:
#   momentum_fit_results.csv  - slope and intercept +- uncertainty per strain
#   momentum_fit.png          - the points with the fitted line per strain

counts <- read.csv("momentum_counts_per_set.csv")
counts$D <- counts$N_WT - counts$N_variant   # difference WT - mutant per set and bin

pairs <- c("E. coli", "Bacillus subtilis", "Pseudomonas aeruginosa",
           "Streptococcus pneumoniae", "Mycobacterium tuberculosis", "Salmonella enterica")
short <- c("E. coli", "B. subtilis", "P. aeruginosa",
           "S. pneumoniae", "M. tuberculosis", "Salmonella")

fit_results <- list()

png("momentum_fit.png", width = 1800, height = 1100, res = 140)
par(mfrow = c(2, 3), mar = c(6.5, 5, 4.5, 1), las = 1, mgp = c(3.6, 0.7, 0))

for (k in seq_along(pairs)) {
  x <- counts[counts$Pair == pairs[k], ]
  bins   <- sort(unique(x$Bin))
  ranges <- x$MomentumRange[match(bins, x$Bin)]

  # Average and uncertainty per momentum bin
  y     <- as.numeric(tapply(x$D, x$Bin, mean))
  sigma <- as.numeric(tapply(x$D, x$Bin, sd))

  # Weighted straight-line fit: y = intercept + slope * bin
  w   <- 1 / sigma^2
  S   <- sum(w)
  Sx  <- sum(w * bins)
  Sxx <- sum(w * bins^2)
  Sy  <- sum(w * y)
  Sxy <- sum(w * bins * y)
  Delta <- S * Sxx - Sx^2

  slope         <- (S * Sxy - Sx * Sy) / Delta
  slope_err     <- sqrt(S / Delta)
  intercept     <- (Sxx * Sy - Sx * Sxy) / Delta
  intercept_err <- sqrt(Sxx / Delta)

  chi2 <- sum(((y - (intercept + slope * bins)) / sigma)^2)
  ndf  <- length(bins) - 2

  fit_results[[k]] <- data.frame(
    Strain                 = pairs[k],
    Slope_per_bin          = round(slope, 1),
    Slope_uncertainty      = round(slope_err, 1),
    Slope_significance     = round(slope / slope_err, 2),
    Slope_significant      = abs(slope / slope_err) >= 3,
    Intercept              = round(intercept, 1),
    Intercept_uncertainty  = round(intercept_err, 1),
    Chi2                   = round(chi2, 2),
    ndf                    = ndf
  )

  # Plot: points with error bars and the fitted line
  ylim <- range(c(y - sigma, y + sigma, 0, intercept + slope * c(0.7, 5.3)))
  plot(bins, y, type = "n", xaxt = "n", ylim = ylim,
       xlim = c(0.7, length(bins) + 0.3),
       ylab = "D = N_WT - N_mutant", xlab = "", main = "")
  title(main = short[k], font.main = 3, cex.main = 1.25, line = 2.4)
  title(main = sprintf("slope = %.1f +/- %.1f per bin (%.1f sigma)",
                       slope, slope_err, slope / slope_err),
        font.main = 1, cex.main = 0.9, line = 1.1)
  axis(1, at = bins, labels = ranges, cex.axis = 0.85)
  mtext(expression("|p| bin (" * 10^-20 ~ "kg m/s)"), side = 1, line = 3.3, cex = 0.8)
  abline(h = 0, lty = 2, col = "grey50")
  arrows(bins, y - sigma, bins, y + sigma, angle = 90, code = 3,
         length = 0.04, lwd = 1.2, col = "grey30")
  abline(a = intercept, b = slope, col = "#C0392B", lwd = 2)
  points(bins, y, pch = 21, bg = "white", col = "#2F5E9E", cex = 1.5, lwd = 2)
}

# Shared legend in the bottom margin
par(fig = c(0, 1, 0, 1), oma = c(0, 0, 0, 0), mar = c(0, 0, 0, 0), new = TRUE)
plot(0, 0, type = "n", bty = "n", xaxt = "n", yaxt = "n")
legend("bottom", horiz = TRUE, bty = "n", cex = 0.95, inset = 0.005,
       legend = c("Average of the 10 sets", "+/- 1 SD", "Straight-line fit",
                  "D = 0 (no difference)"),
       pch = c(21, NA, NA, NA), pt.bg = "white", pt.cex = 1.3, pt.lwd = 2,
       col = c("#2F5E9E", "grey30", "#C0392B", "grey50"),
       lty = c(NA, 1, 1, 2), lwd = c(NA, 1.2, 2, 1))
dev.off()

fit_results <- do.call(rbind, fit_results)

options(scipen = 999, width = 200)
cat("Straight-line fit  D = intercept + slope * bin  (bin = 1 ... 5)\n\n")
print(fit_results, row.names = FALSE)

write.csv(fit_results, "momentum_fit_results.csv", row.names = FALSE)
cat("\nSaved momentum_fit_results.csv and momentum_fit.png\n")
